# Snipe-IT CLI Environment Configuration
# Copy this file to .env or export these variables in your shell.

# Base URL of your Snipe-IT instance (without trailing slash or /api/v1)
SNIPEIT_URL="https://snipeit.example.com"

# Personal API Token (Generated in Snipe-IT: Top Right Profile -> Manage API Keys)
SNIPEIT_API_TOKEN="your_personal_api_token_here"

# Default profile to load ('dev' or 'prod')
SNIPEIT_PROFILE="dev"
